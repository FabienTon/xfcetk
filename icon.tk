# Resize img, pass img and new size
 proc resizeIMG { myimg s } {
	 set factor [expr 128 / $s]
	set Imodified [image create photo -width $s -height $s]
    $Imodified copy $myimg -shrink -subsample $factor
     return $Imodified
 }
