package require Tk

image create photo i22download -data {}
image create photo i22doc -data {}
image create photo i22bin -data {}
image create photo i22desktop -data {}
image create photo i22music -data {}
image create photo i22video -data {}
image create photo i22picture -data {}
image create photo i22addfolder -data {}
image create photo i20cancel -data {}
image create photo i20valid -data {}
image create photo i22folder -data {}


proc modernFileDialog {startDir} {
global currentDir selectedFile
set selectedFile ""
set currentDir $startDir

# Fenêtre modale
toplevel .dlg
wm title .dlg "Sélectionner un fichier"
wm geometry .dlg 800x500
wm transient .
wm protocol .dlg WM_DELETE_WINDOW {destroy .dlg; set selectedFile ""}

# Frame du haut pour nom du fichier
pack [frame .dlg.topFrame -padx 5 -pady 5] -fill x
pack [label .dlg.topFrame.nameLbl -text "Fichier: "] -side left -padx 5
pack [entry .dlg.topFrame.nameEntry -width 50 -textvariable selectedFile] -side left -fill x -expand 1
  
# ---------------- Succession de boutons du chemin + bouton + ----------------
pack [frame .dlg.pathButtonsFrame] -fill x -padx 5 -pady 5

# Frame principale gauche/droite
pack [frame .dlg.main] -fill both -expand 1
pack [frame .dlg.main.left -padx 5] -side left -fill y -expand 0
pack [frame .dlg.main.right] -side right -fill both -expand 1

# Liens rapides à gauche
set quickLinks [list Documents Bureau Images Musique Vidéos Corbeille Téléchargements]
set quickimg [list i22doc i22desktop i22picture i22music i22video i22bin i22download]
set idx 0
foreach link $quickLinks { 
  set wName [string map {" " "_" "é" "e" "è" "e" "à" "a"} [string tolower $link]]
  button .dlg.main.left.$wName -text $link -image [lindex $quickimg $idx] -compound left -command [list setCurrentDir $link]
  pack .dlg.main.left.$wName -anchor nw -pady 1 -fill x
  set idx [incr idx]
    }

# Frame pour la listbox
frame .dlg.main.right.listFrame
pack .dlg.main.right.listFrame -side top -fill both -expand 1 -pady 5

# Listbox + scrollbar dans sa frame
listbox .dlg.main.right.listFrame.fileList -width 60 -height 20
pack .dlg.main.right.listFrame.fileList -side left -fill both -expand 1
scrollbar .dlg.main.right.listFrame.scroll -orient vertical -command ".dlg.main.right.listFrame.fileList yview"
.dlg.main.right.listFrame.fileList configure -yscrollcommand ".dlg.main.right.listFrame.scroll set"
pack .dlg.main.right.listFrame.scroll -side right -fill y

    # ---------------- Fonctions internes ----------------
    proc updatePathButtons {} {
        global currentDir
        destroy .dlg.pathButtonsFrame
        frame .dlg.pathButtonsFrame
        pack .dlg.pathButtonsFrame -after .dlg.topFrame -side top -fill x -padx 5 -pady 5
        set dirs [split [file normalize $currentDir] "/"]
        set pathAccum "/"
        foreach d $dirs {
            if {$d eq ""} {continue}
            set pathAccum [file join $pathAccum $d]
            button .dlg.pathButtonsFrame.b$pathAccum -text $d -image i22folder -compound left -command [list setCurrentDir $pathAccum]
            pack .dlg.pathButtonsFrame.b$pathAccum -side left -padx 2
        }
        button .dlg.pathButtonsFrame.plus -image i22addfolder -command {createNewFolderWindow}
        pack .dlg.pathButtonsFrame.plus -side right -padx 5
    }

    proc listDir {dir} {
        .dlg.main.right.listFrame.fileList delete 0 end
        foreach f [lsort [glob -nocomplain -directory $dir *]] {
            if {[file isdirectory $f]} {
                .dlg.main.right.listFrame.fileList insert end "[file tail $f]/"
            } else {
                .dlg.main.right.listFrame.fileList insert end [file tail $f]
            }
        }
    }

    proc setCurrentDir {dir} {
        global currentDir
        set currentDir [file join $::env(HOME) $dir]
        updatePathButtons
        listDir $currentDir
    }

proc createNewFolderWindow {} {
global currentDir
toplevel .dlg.newFolder
wm title .dlg.newFolder "Nouveau dossier"
wm transient .dlg
label .dlg.newFolder.lbl -text "Nom du dossier:"
entry .dlg.newFolder.entry -width 30
button .dlg.newFolder.ok -text "Créer" -command {
set newName [.dlg.newFolder.entry get]
if {$newName eq ""} {return}
file mkdir [file join $currentDir $newName]
destroy .dlg.newFolder
listDir $currentDir
}

button .dlg.newFolder.cancel -text "Annuler" -command {destroy .dlg.newFolder}
pack .dlg.newFolder.lbl -side top -pady 5
pack .dlg.newFolder.entry -side top -pady 5
pack .dlg.newFolder.ok .dlg.newFolder.cancel -side left -padx 10 -pady 5
}

# Boutons en bas
pack [frame .dlg.buttons] -fill x -padx 10 -pady 5

button .dlg.buttons.open -text "Ouvrir" -image i20valid -compound left  -command {
        global currentDir selectedFile
        set sel [.dlg.main.right.listFrame.fileList curselection]
        if {[llength $sel] == 0} {return}
        set selItem [.dlg.main.right.listFrame.fileList get [lindex $sel 0]]
        if {[string match "*/*" $selItem]} {
            set CurrentDir [file join $currentDir $selItem]
            return
        } else {
			global currentDir ; set s "/"
            set selectedFile [file tail $selItem]
            set selectedFile $currentDir$s$selectedFile
            destroy .dlg
        }
    }
    button .dlg.buttons.cancel -text "Annuler" -image i20cancel -compound left -command {
        global selectedFile
        set selectedFile ""
        destroy .dlg
    }
    pack .dlg.buttons.open .dlg.buttons.cancel -side right -padx 5
    

    # Binds
    bind .dlg.main.right.listFrame.fileList <Double-1> {
        global currentDir selectedFile
        set sel [.dlg.main.right.listFrame.fileList get active]
        if {[string match "*/*" $sel]} {
            setCurrentDir [file join $currentDir $sel]
        } else {
            set selectedFile [file tail $sel]
            destroy .dlg
        }
    }
    # Bind pour recherche alphabétique
bind .dlg.main.right.listFrame.fileList <Key> {
    set c %A  ;# caractère tapé
    set found 0
    for {set i 0} {$i < [.dlg.main.right.listFrame.fileList size]} {incr i} {
        set item [.dlg.main.right.listFrame.fileList get $i]
        # On enlève le "/" final pour les dossiers
        if {[string index $item end] eq "/"} {
            set item [string range $item 0 end-1]
        }
        if {[string match "$c*" $item]} {
            .dlg.main.right.listFrame.fileList selection clear 0 end
            .dlg.main.right.listFrame.fileList selection set $i
            .dlg.main.right.listFrame.fileList see $i
            set found 1
            break
        }
    }
    if {!$found} {
        bell  ;# signal si rien trouvé
    }
}
    

    bind .dlg.main.right.listFrame.fileList <<ListboxSelect>> {
        global selectedFile
        set sel [.dlg.main.right.listFrame.fileList curselection]
        if {[llength $sel] > 0} {
            set item [.dlg.main.right.listFrame.fileList get [lindex $sel 0]]
            if {[string match "*/*" $item]} {
                set selectedFile ""
            } else {
                set selectedFile $item
            }
        }
    }

    # Initialisation
    updatePathButtons
    setCurrentDir $currentDir

    tkwait window .dlg
    return $selectedFile
}

